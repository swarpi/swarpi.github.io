---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('writing', ({ data }) => !data.private);
const sortedPosts = posts.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
---

<BaseLayout title="Writing" description="Essays and notes">
  <section class="header">
    <h1 class="reveal">Writing</h1>
    <p class="intro reveal reveal-delay-1">Essays, notes, and thoughts on software engineering.</p>
  </section>

  {sortedPosts.length > 0 ? (
    <ul class="post-list">
      {sortedPosts.map((post, i) => (
        <li class:list={['reveal', `reveal-delay-${(i % 2) + 1}`]}>
          <a href={`/writing/${post.slug}`} class="post-link">
            <span class="post-title">{post.data.title}</span>
            <span class="post-date">
              {post.data.publishedAt.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
              })}
            </span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty reveal">No posts yet. Check back soon.</p>
  )}
</BaseLayout>

<style>
  .header {
    margin-bottom: var(--space-xl);
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 900;
    font-variation-settings: 'opsz' 144, 'WONK' 1;
    margin-top: 0;
    margin-bottom: var(--space-sm);
    line-height: 0.95;
  }

  .intro {
    color: var(--color-text-muted);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .post-list {
    list-style: none;
    padding: 0;
  }

  .post-list li {
    border-bottom: 1px solid var(--color-border);
  }

  .post-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: var(--space-sm) 0;
    color: var(--color-text);
    transition: all 0.3s ease;
  }

  .post-link:hover {
    color: var(--color-accent);
    text-decoration: none;
    padding-left: 8px;
  }

  .post-title {
    font-weight: 700;
    font-size: 1.1rem;
  }

  .post-date {
    color: var(--color-text-dim);
    font-size: 0.875rem;
    font-weight: 600;
    flex-shrink: 0;
    margin-left: var(--space-sm);
  }

  .empty {
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
