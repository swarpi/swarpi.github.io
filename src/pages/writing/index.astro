---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('writing', ({ data }) => !data.private);
const sortedPosts = posts.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
---

<BaseLayout title="Writing" description="Essays and notes">
  <h1>Writing</h1>
  <p class="intro">Essays, notes, and thoughts on software engineering.</p>

  {sortedPosts.length > 0 ? (
    <ul class="post-list">
      {sortedPosts.map((post) => (
        <li>
          <a href={`/writing/${post.slug}`}>{post.data.title}</a>
          <span class="date">
            {post.data.publishedAt.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
            })}
          </span>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty">No posts yet. Check back soon.</p>
  )}
</BaseLayout>

<style>
  h1 {
    margin-top: 0;
  }

  .intro {
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .post-list {
    list-style: none;
    padding: 0;
  }

  .post-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .post-list a {
    font-weight: 500;
  }

  .date {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .empty {
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
