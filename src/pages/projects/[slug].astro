---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { fetchShowcaseProjects } from '@/lib/github';

export async function getStaticPaths() {
  const projects = await fetchShowcaseProjects();

  return projects.map((project) => ({
    params: { slug: project.name },
    props: { project },
  }));
}

const { project } = Astro.props;

const formattedDate = project.updatedAt.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={project.name} description={project.description}>
  <article>
    <header class="reveal">
      <h1>{project.name}</h1>
      <p class="description">{project.description}</p>
      <div class="meta">
        {project.language && <span class="language-badge">{project.language}</span>}
        <span>Updated {formattedDate}</span>
        <a href={project.url} target="_blank" rel="noopener noreferrer">
          View on GitHub &rarr;
        </a>
      </div>
    </header>

    {project.readme && (
      <section class="readme reveal">
        <h2>README</h2>
        <div class="readme-body" set:html={project.readme} />
      </section>
    )}
  </article>
</BaseLayout>

<style>
  header {
    margin-bottom: 96px;
    padding-bottom: 64px;
    border-bottom: 1px solid var(--rule);
  }

  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 400;
    margin-top: 6vh;
    margin-bottom: 16px;
    line-height: 1.1;
  }

  .description {
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--ink-3);
    margin-bottom: 32px;
    max-width: 60ch;
    line-height: 1.7;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--muted);
    align-items: center;
  }

  .language-badge {
    font-family: 'Geist Mono', monospace;
    font-weight: 500;
    color: var(--ink-3);
    background-color: var(--paper-2);
    padding: 4px 12px;
    border-radius: 100px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .meta a {
    color: var(--ink);
    font-weight: 500;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1px;
    transition: color 0.15s, border-color 0.15s;
  }

  .meta a:hover { color: var(--accent); border-color: var(--accent); }

  .readme h2 {
    font-size: 1.2rem;
    margin-top: 0;
    margin-bottom: 16px;
  }

  .readme-body :global(h1) { font-size: 1.5rem; margin: 2rem 0 0.75rem; }
  .readme-body :global(h2) { font-size: 1.25rem; margin: 1.75rem 0 0.5rem; }
  .readme-body :global(h3) { font-size: 1.1rem; margin: 1.5rem 0 0.5rem; }
  .readme-body :global(img) { max-width: 100%; border-radius: 8px; }
  .readme-body :global(a) { color: var(--accent); border-bottom: 1px solid var(--rule); }
  .readme-body :global(a:hover) { border-color: var(--accent); }
  .readme-body :global(pre) { white-space: pre-wrap; word-wrap: break-word; }
</style>
