---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { fetchShowcaseProjects } from '@/lib/github';

const projects = await fetchShowcaseProjects();
---

<BaseLayout title="Projects" description="Open source work and experiments">
  <section class="header">
    <h1 class="reveal">Projects</h1>
    <p class="intro reveal reveal-delay-1">
      Open source work and experiments. These are repositories I've tagged with
      <code>showcase</code> on GitHub.
    </p>
  </section>

  {projects.length > 0 ? (
    <div class="project-grid">
      {projects.map((project, i) => (
        <div class:list={['reveal', `reveal-delay-${(i % 3) + 1}`]}>
          <ProjectCard project={project} />
        </div>
      ))}
    </div>
  ) : (
    <p class="empty reveal">No showcase projects yet. Check back soon.</p>
  )}
</BaseLayout>

<style>
  .header {
    margin-bottom: var(--space-xl);
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 900;
    font-variation-settings: 'opsz' 144, 'WONK' 1;
    margin-top: 0;
    margin-bottom: var(--space-sm);
    line-height: 0.95;
  }

  .intro {
    color: var(--color-text-muted);
    font-weight: 600;
    font-size: 1.1rem;
    max-width: 50ch;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .empty {
    color: var(--color-text-muted);
    font-style: italic;
  }

  @media (max-width: 1048px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
