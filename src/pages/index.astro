---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { fetchShowcaseProjects } from '@/lib/github';

const projects = await fetchShowcaseProjects();
const projectCount = String(projects.length).padStart(2, '0');
---

<BaseLayout title="Home">
  <header class="hero-grid">
    <div class="hero-left">
      <div class="kicker rotator" aria-label="Software / Agentic / Food / Game">
        <span class="word">Software</span>
      </div>
      <h1 class="display">Engineer</h1>
      <p class="sub">Building things with TypeScript, Python, and Java &mdash; shipping agentic workflows and AI-powered applications with Claude Code.</p>
      <div class="icons">
        <a href="https://github.com/swarpi" aria-label="GitHub" title="GitHub">
          <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.34.95.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.16 1.18a10.97 10.97 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56 4.56-1.52 7.85-5.83 7.85-10.91C23.5 5.65 18.35.5 12 .5Z"/></svg>
        </a>
        <a href="mailto:nguyendtrung15@gmail.com" aria-label="Email" title="Email">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        </a>
      </div>
    </div>

    <aside class="hero-right">
      <h3>Based in Berlin</h3>
      <h4>M.Sc. Information Systems Management, TU Berlin</h4>
      <p>Currently building agentic developer tools and AI-powered applications using Claude Code.</p>
      <p>Associate Engineer at Deutsche Bank, modernizing commercial banking on GCP.</p>
      <div class="timeline">
        <div class="timeline-col">
          <span class="timeline-label">Current</span>
          <span>Deutsche Bank</span>
        </div>
        <div class="timeline-col">
          <span class="timeline-label">Past</span>
          <span>TU Berlin &middot; cliqe &middot; Capgemini</span>
        </div>
      </div>
      <a class="more" href="/about">About me &rarr;</a>
    </aside>
  </header>

  <section class="selected-work">
    <div class="sec-head">
      <h2>Selected Work</h2>
      <span class="count">{projectCount} &middot; Active</span>
    </div>

    {projects.length > 0 ? (
      <div class="proj-grid">
        {projects.slice(0, 4).map((project, i) => (
          <div class:list={['reveal', `reveal-delay-${(i % 2) + 1}`]}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>
    ) : (
      <p class="empty reveal">Projects coming soon.</p>
    )}

    {projects.length > 0 && (
      <a class="more-all" href="/projects">View all projects &rarr;</a>
    )}
  </section>

  <div class="cta-line">
    <p>More on <a href="/workflow">how I work with AI agents</a>, explore the <a href="/hub">Project Hub</a>, or read <a href="/writing">essays &amp; working notes</a>.</p>
  </div>
</BaseLayout>

<style>
  .hero-grid {
    margin-top: 10vh;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 96px;
    align-items: start;
    position: relative;
    padding-bottom: 32px;
  }

  .hero-left .kicker {
    font-family: 'Geist', sans-serif;
    font-size: clamp(52px, 7vw, 108px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.08;
    margin-bottom: -0.1em;
    display: inline-flex;
    align-items: flex-start;
    vertical-align: top;
    overflow: hidden;
    padding: 0.06em 0.06em;
    margin-left: -0.06em;
  }

  .hero-left .kicker .word {
    display: inline-block;
    color: #8a8a82;
    background-image: url('data:image/svg+xml;base64,');
    background-size: 320px 320px;
    background-repeat: repeat;
    -webkit-background-clip: text;
            background-clip: text;
    -webkit-text-fill-color: transparent;
    will-change: transform;
    transition: transform .48s cubic-bezier(.6, .02, .2, 1);
  }

  .hero-left .kicker .word.is-leaving  { transform: translateY(108%); }
  .hero-left .kicker .word.is-entering { transform: translateY(-108%); }
  .hero-left .kicker .word.no-anim     { transition: none !important; }

  @media (prefers-reduced-motion: reduce) {
    .hero-left .kicker .word { transition: opacity .18s ease; }
    .hero-left .kicker .word.is-leaving,
    .hero-left .kicker .word.is-entering { transform: none; opacity: 0; }
  }

  .hero-left .display {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(72px, 9.5vw, 144px);
    font-weight: 400;
    font-style: normal;
    letter-spacing: -0.015em;
    line-height: 0.95;
    margin-top: 0;
    color: var(--ink);
  }

  .hero-left .sub {
    margin-top: 56px;
    font-size: 18px;
    line-height: 1.7;
    max-width: 540px;
    color: var(--ink-3);
  }

  .hero-left .icons {
    margin-top: 56px;
    display: flex;
    gap: 22px;
  }

  .hero-left .icons a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: var(--ink-2);
    transition: color 0.15s, transform 0.15s;
  }

  .hero-left .icons a:hover { color: var(--ink); transform: translateY(-1px); }
  .hero-left .icons svg { width: 22px; height: 22px; }

  .hero-right {
    position: relative;
    padding-left: 32px;
    border-left: 1px solid var(--rule);
  }

  .hero-right h3 {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0 0 4px;
  }

  .hero-right h4 {
    font-size: 19px;
    font-weight: 400;
    letter-spacing: -0.005em;
    line-height: 1.4;
    color: var(--ink-3);
    margin: 0 0 4px;
    max-width: 320px;
  }

  .hero-right p {
    font-size: 17px;
    color: var(--ink-3);
    line-height: 1.5;
    max-width: 360px;
    margin-bottom: 0;
  }

  .timeline {
    display: flex;
    gap: 40px;
    margin-top: 20px;
  }

  .timeline-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 15px;
    color: var(--ink-3);
    line-height: 1.45;
  }

  .timeline-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 2px;
  }

  .hero-right .more {
    display: inline-block;
    margin-top: 20px;
    font-size: 17px;
    font-weight: 500;
    color: var(--ink);
    transition: color 0.15s;
  }

  .hero-right .more:hover { color: var(--accent); }

  /* Selected Work */
  .selected-work { margin-top: 40px; }

  .sec-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 20px;
  }

  .sec-head h2 {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--ink);
    margin: 0;
  }

  .count {
    font-family: 'Geist Mono', monospace;
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .proj-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px 24px;
  }

  .more-all {
    margin-top: 28px;
    display: inline-block;
    font-size: 14px;
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
    padding-bottom: 2px;
    transition: color .15s, border-color .15s;
  }

  .more-all:hover { color: var(--accent); border-color: var(--accent); }

  .empty {
    color: var(--muted);
    grid-column: 1 / -1;
  }

  /* CTA line */
  .cta-line {
    margin-top: 80px;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
  }

  .cta-line p {
    font-size: 15px;
    color: var(--ink-3);
    max-width: 480px;
    line-height: 1.55;
    margin: 0;
  }

  .cta-line p a {
    color: var(--ink);
    border-bottom: 1px solid var(--ink-3);
    padding-bottom: 1px;
    transition: border-color .15s, color .15s;
  }

  .cta-line p a:hover { color: var(--accent); border-color: var(--accent); }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 56px;
      margin-top: 4vh;
      padding-bottom: 32px;
    }
    .hero-right {
      padding-left: 0;
      padding-top: 24px;
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }

  @media (max-width: 900px) {
    .proj-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .proj-grid { grid-template-columns: 1fr; gap: 24px; }
  }
</style>

<script>
  let _rotatorId: ReturnType<typeof setInterval> | undefined;

  function initRotator() {
    if (_rotatorId) clearInterval(_rotatorId);

    const WORDS = ['Software', 'Agentic', 'Food', 'Game'];
    const DWELL_MS = 2600;
    const OUT_MS = 480;

    const el = document.querySelector('.kicker.rotator .word') as HTMLElement | null;
    if (!el) return;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const outMs = reduced ? 160 : OUT_MS;
    let i = 0;

    function tick() {
      el!.classList.add('is-leaving');
      setTimeout(() => {
        el!.classList.add('no-anim');
        el!.classList.remove('is-leaving');
        el!.classList.add('is-entering');
        i = (i + 1) % WORDS.length;
        el!.textContent = WORDS[i];
        void el!.offsetHeight;
        el!.classList.remove('no-anim');
        requestAnimationFrame(() => {
          el!.classList.remove('is-entering');
        });
      }, outMs);
    }

    _rotatorId = setInterval(tick, DWELL_MS);
  }
  initRotator();
  document.addEventListener('astro:after-swap', initRotator);
</script>
