---
import ProjectGrid from '@/components/ProjectGrid';
import { fetchProjectsWithOrchestrations } from '@/lib/orchestration';

const projects = await fetchProjectsWithOrchestrations();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Agent orchestrations for my projects" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Workflow | swarpi</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { width: 100%; min-height: 100vh; background: oklch(0.97 0.008 80); }
    </style>
  </head>
  <body>
    <ProjectGrid client:load projects={projects} />
  </body>
</html>
