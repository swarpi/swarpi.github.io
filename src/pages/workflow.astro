---
import ProjectGrid from '@/components/ProjectGrid';
import ThemeToggle from '@/components/ThemeToggle.astro';
import '@/styles/global.css';
import { fetchProjectsWithOrchestrations } from '@/lib/orchestration';

const projects = await fetchProjectsWithOrchestrations();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Agent orchestrations for my projects" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Workflow | swarpi</title>
    <script is:inline>
      (function() {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { width: 100%; min-height: 100vh; background: var(--wf-bg); }
    </style>
  </head>
  <body>
    <div class="theme-toggle-float">
      <ThemeToggle />
    </div>
    <ProjectGrid client:load projects={projects} />
    <style>
      .theme-toggle-float {
        position: fixed;
        top: 16px;
        right: 16px;
        z-index: 100;
      }
    </style>
  </body>
</html>
