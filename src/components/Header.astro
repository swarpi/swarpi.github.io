---
import ThemeToggle from './ThemeToggle.astro';

const navLinks: { href: string; label: string; external?: boolean }[] = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: 'https://swarpi.github.io/project-hub/', label: 'Hub', external: true },
  { href: '/workflow', label: 'Workflow' },
  { href: '/projects', label: 'Projects' },
  { href: '/writing', label: 'Writing' },
];

const currentPath = Astro.url.pathname;
---

<header>
  <div class="nav-blur"></div>
  <nav>
    <a href="/" class="site-name">swarpi</a>
    <button class="mobile-toggle" aria-label="Toggle menu" aria-expanded="false">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path class="line line-top" d="M3 6h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        <path class="line line-bottom" d="M3 14h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </button>
    <div class="nav-right">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[{ active: !link.external && (currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))) }]}
              {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 999;
  }

  .nav-blur {
    position: absolute;
    inset: 0;
    height: 130%;
    z-index: -1;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    mask: linear-gradient(to bottom, #000 0%, #000 60%, transparent 100%);
    -webkit-mask: linear-gradient(to bottom, #000 0%, #000 60%, transparent 100%);
  }

  nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-sm) var(--space-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .site-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    color: var(--color-text);
  }

  .site-name:hover {
    text-decoration: none;
    color: var(--color-text);
  }

  .mobile-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 100px;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .mobile-toggle:hover {
    background-color: var(--color-nav-hover);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    margin: 0;
  }

  ul a {
    display: block;
    padding: 8px 16px;
    border-radius: 100px;
    color: var(--color-text-dim);
    font-size: 1rem;
    font-weight: 700;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  ul a:hover {
    background-color: var(--color-nav-hover);
    color: var(--color-text);
    text-decoration: none;
  }

  ul a.active {
    background-color: var(--color-nav-active);
    color: var(--color-text);
  }

  @media (max-width: 768px) {
    .mobile-toggle {
      display: flex;
    }

    .nav-right {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      padding: var(--space-sm) var(--space-md) var(--space-md);
      background-color: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
    }

    .nav-right.open {
      display: flex;
    }

    ul {
      flex-direction: column;
      gap: 2px;
      width: 100%;
    }

    ul a {
      border-radius: 12px;
      padding: 12px 16px;
    }
  }
</style>

<script>
  function initMobileNav() {
    const toggle = document.querySelector('.mobile-toggle') as HTMLButtonElement;
    const navRight = document.querySelector('.nav-right') as HTMLElement;
    if (!toggle || !navRight) return;

    toggle.addEventListener('click', () => {
      const isOpen = navRight.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(isOpen));
    });

    document.addEventListener('click', (e) => {
      if (!toggle.contains(e.target as Node) && !navRight.contains(e.target as Node)) {
        navRight.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  }

  initMobileNav();
  document.addEventListener('astro:after-swap', initMobileNav);
</script>
