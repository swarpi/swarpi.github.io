---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/workflow', label: 'Workflow' },
  { href: '/writing', label: 'Writing' },
];

const currentPath = Astro.url.pathname;
---

<nav class="nav">
  <a href="/" class="brand">swarpi</a>
  <ul>
    {navLinks.map((link) => (
      <li>
        <a
          href={link.href}
          class:list={[{ active: currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 28px;
  }

  .brand {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  ul {
    display: flex;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li { margin: 0; }

  ul a {
    font-size: 14px;
    color: var(--ink-3);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: color 0.15s;
  }

  ul a:hover { color: var(--ink); }

  ul a.active {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  @media (max-width: 640px) {
    .nav { flex-wrap: wrap; gap: 12px; }
    ul { gap: 14px; flex-wrap: wrap; }
  }
</style>
