---
const year = new Date().getFullYear();
---

<footer class="foot">
  <span class="mono">swarpi &middot; &copy; {year} Trung Duc Nguyen</span>
  <div class="links">
    <a class="mono" href="https://github.com/swarpi">GitHub</a>
    <a class="mono" href="/rss.xml">RSS</a>
    <a class="mono" href="mailto:nguyendtrung15@gmail.com">Email</a>
  </div>
</footer>

<style>
  .foot {
    margin-top: 80px;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 13px;
  }

  .links {
    display: flex;
    gap: 18px;
  }

  .foot a {
    color: var(--ink-3);
    transition: color 0.15s;
  }

  .foot a:hover { color: var(--ink); }
</style>
