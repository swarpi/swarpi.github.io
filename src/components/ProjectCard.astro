---
import type { ShowcaseProject } from '@/lib/github';

interface Props {
  project: ShowcaseProject;
}

const { project } = Astro.props;

const formattedDate = project.updatedAt.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
});

const thumbGradients: Record<string, string> = {
  TypeScript: 'radial-gradient(120% 80% at 10% 0%, #2a2925 0%, #14140f 55%, #14140f 100%)',
  Python: 'linear-gradient(135deg, #c9a187 0%, #a8442a 100%)',
  Java: 'linear-gradient(160deg, #d8d6cf 0%, #b8b6ad 50%, #8e8c83 100%)',
};
const thumbBg = thumbGradients[project.language ?? ''] ?? 'linear-gradient(160deg, #d8d6cf 0%, #b8b6ad 50%, #8e8c83 100%)';

const thumbClasses: Record<string, string> = {
  TypeScript: 'ph-a',
  Python: 'ph-b',
};
const phClass = thumbClasses[project.language ?? ''] ?? 'ph-c';
---

<a href={`/projects/${project.name}`} class="proj-card">
  <div class:list={['thumb', phClass]} style={`background: ${thumbBg};`}>
  </div>
  <div class="meta">
    <span>{formattedDate}</span>
    {project.language && <span class="lang">{project.language}</span>}
  </div>
  <div class="row">
    <h3>{project.name}</h3>
    <span class="arr">&rarr;</span>
  </div>
  <p>{project.description}</p>
</a>

<style>
  .proj-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: var(--ink);
  }

  .thumb {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    overflow: hidden;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .proj-card:hover .thumb {
    transform: translateY(-2px);
    box-shadow: 0 16px 32px -22px rgba(20,20,15,0.32);
  }

  .thumb.ph-a::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('data:image/svg+xml;base64,');
    background-size: 240px 240px;
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .thumb.ph-b::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(45deg, rgba(255,255,255,0.05) 0 2px, transparent 2px 14px);
    pointer-events: none;
  }

  .thumb.ph-c::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(120% 80% at 90% 110%, rgba(255,255,255,0.5), transparent 60%);
    pointer-events: none;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 14px;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .meta .lang { color: var(--ink-3); }

  h3 {
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0;
  }

  p {
    font-size: 14px;
    color: var(--ink-3);
    line-height: 1.5;
    margin: -6px 0 0;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 14px;
  }

  .arr {
    color: var(--muted-2);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .proj-card:hover .arr {
    transform: translateX(3px);
    color: var(--ink);
  }
</style>
