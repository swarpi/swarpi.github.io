---
import type { ProjectWithOrchestration } from '@/lib/orchestration';

interface Props {
  project: ProjectWithOrchestration;
}

const { project } = Astro.props;

const formattedDate = project.updatedAt.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
});
---

<a href={`/workflow/${project.name}`} class="workflow-project-card">
  <div class="card-content">
    <div class="card-top">
      <div class="comp-section">
        <h3>{project.name}</h3>
        {project.language && (
          <span class="status">{project.language}</span>
        )}
      </div>
    </div>
    <p class="description">{project.description}</p>
    <span class="date">Updated {formattedDate}</span>
  </div>
</a>

<style>
  .workflow-project-card {
    display: block;
    border-radius: 12px;
    background-color: var(--color-bg-alt);
    color: var(--color-text);
    transition: transform 0.4s ease;
    overflow: hidden;
    height: 100%;
  }

  .workflow-project-card:hover {
    transform: scale(1.03);
    text-decoration: none;
    color: var(--color-text);
  }

  .card-content {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-top {
    margin-bottom: var(--space-sm);
  }

  .comp-section {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0;
  }

  .status {
    display: flex;
    align-items: center;
    padding: 0 8px;
    height: 28px;
    border: 1.5px solid var(--color-border);
    border-radius: 100px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-dim);
    flex-shrink: 0;
  }

  .description {
    color: var(--color-text-muted);
    margin-bottom: auto;
    padding-bottom: var(--space-sm);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.6;
  }

  .date {
    font-size: 0.8rem;
    color: var(--color-text-dim);
    font-weight: 600;
  }
</style>
