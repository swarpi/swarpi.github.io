---
import type { ProjectWithOrchestration } from '@/lib/orchestration';

interface Props {
  project: ProjectWithOrchestration;
}

const { project } = Astro.props;

const formattedDate = project.updatedAt.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
});
---

<a href={`/workflow/${project.name}`} class="workflow-project-card">
  <div class="card-content">
    <div class="card-top">
      <div class="comp-section">
        <h3>{project.name}</h3>
        {project.language && (
          <span class="status">{project.language}</span>
        )}
      </div>
    </div>
    <p class="description">{project.description}</p>
    <span class="date">Updated {formattedDate}</span>
  </div>
</a>

<style>
  .workflow-project-card {
    display: block;
    border-radius: 8px;
    background-color: var(--paper-2);
    color: var(--ink);
    transition: transform 0.4s ease;
    overflow: hidden;
    height: 100%;
  }

  .workflow-project-card:hover {
    transform: scale(1.03);
    text-decoration: none;
    color: var(--ink);
  }

  .card-content {
    padding: 32px;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-top {
    margin-bottom: 16px;
  }

  .comp-section {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0;
  }

  .status {
    display: flex;
    align-items: center;
    padding: 0 8px;
    height: 28px;
    border: 1px solid var(--rule);
    border-radius: 100px;
    font-family: 'Geist Mono', monospace;
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    flex-shrink: 0;
  }

  .description {
    color: var(--ink-3);
    margin-bottom: auto;
    padding-bottom: 16px;
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.6;
  }

  .date {
    font-family: 'Geist Mono', monospace;
    font-size: 0.75rem;
    color: var(--muted);
    font-weight: 400;
  }
</style>
